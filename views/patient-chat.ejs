<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support Chat - HMS</title>
    <link rel="stylesheet" href="/css/glass.css" />
  </head>
  <body>
    <div class="chat-container">
      <div class="nav">
        <a href="/patient">Book Appointment</a>
        <a href="/doctors">Find a Doctor</a>
        <a href="/my-appointments">My Appointments</a>
        <a href="#" onclick="logout()">Logout</a>
      </div>

      <header>
        <h1 style="color: #fff;">Support Chat</h1>
        <p style="color: #fff;">Chat directly with our support team.</p>
      </header>

      <div id="blocked" class="blocked" style="display: none">
        Please <a href="/login">login</a> to chat with support.
      </div>

      <div id="chatArea" style="display: none">
        <div id="messages" class="messages"></div>
        <form id="form">
          <input id="input" autocomplete="off" placeholder="Type your message..." />
          <button type="submit">Send</button>
        </form>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const token = localStorage.getItem("token");

      if (!token) {
        document.getElementById("blocked").style.display = "block";
      } else {
        document.getElementById("chatArea").style.display = "block";
        init();
      }

      let socket;
      let room = null;

      async function init() {
        try {
          const response = await fetch("/api/patients/my-chat", {
            headers: { Authorization: "Bearer " + token },
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "Could not start chat");

          room = data.chat.room;

          socket = io(window.location.origin, { auth: { token } });

          socket.on("connect", () => {
            socket.emit("joinRoom", { room });
          });

          socket.on("connect_error", (err) => addSystemMessage("Connect error: " + err.message));
          socket.on("chat history", (history) => history.forEach((m) => renderMessage(m)));
          socket.on("chat message", (m) => renderMessage(m));
          socket.on("system message", (sysMsg) => addSystemMessage(sysMsg.text));
          socket.on("error message", (text) => addSystemMessage(text));
        } catch (err) {
          addSystemMessage(err.message);
        }
      }

      const form = document.getElementById("form");
      const input = document.getElementById("input");
      const messages = document.getElementById("messages");

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const message = input.value.trim();
        if (!message || !room) return;

        socket.emit("chat message", { room, message });
        input.value = "";
      });

      function renderMessage(chat) {
        const isSelf = chat.senderRole === "patient";
        const item = document.createElement("div");
        item.className = `message ${isSelf ? "self" : "other"}`;

        const meta = document.createElement("div");
        meta.className = "meta";
        meta.textContent = `${chat.senderName || chat.senderIdentifier} • ${formatTime(chat.createdAt)}`;

        const text = document.createElement("div");
        text.textContent = chat.message;

        item.appendChild(meta);
        item.appendChild(text);
        messages.appendChild(item);
        messages.scrollTop = messages.scrollHeight;
      }

      function formatTime(value) {
        const date = value ? new Date(value) : new Date();
        return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }

      function addSystemMessage(text) {
        const item = document.createElement("div");
        item.className = "system-message";
        item.textContent = text;
        messages.appendChild(item);
        messages.scrollTop = messages.scrollHeight;
      }

      function logout() {
        localStorage.removeItem("token");
        localStorage.removeItem("userId");
        localStorage.removeItem("username");
        localStorage.removeItem("email");
        localStorage.removeItem("role");
        window.location.href = "/login";
      }
    </script>
  </body>
</html>
