<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Support Dashboard</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f6fb;
        color: #1c2331;
      }
      .layout {
        display: grid;
        grid-template-columns: 300px 1fr;
        height: 100vh;
      }
      .sidebar {
        background: #fff;
        border-right: 1px solid #e2e8f0;
        display: flex;
        flex-direction: column;
      }
      .sidebar header {
        padding: 18px;
        border-bottom: 1px solid #e2e8f0;
      }
      .sidebar header h1 {
        margin: 0 0 4px;
        font-size: 1.2rem;
      }
      .sidebar header p {
        margin: 0;
        font-size: 0.8rem;
        color: #64748b;
      }
      .chat-list {
        flex: 1;
        overflow-y: auto;
      }
      .chat-item {
        padding: 14px 18px;
        border-bottom: 1px solid #f1f5f9;
        cursor: pointer;
      }
      .chat-item:hover {
        background: #f8fafc;
      }
      .chat-item.active {
        background: #eef2ff;
      }
      .chat-item .name {
        font-weight: 700;
        font-size: 0.95rem;
      }
      .chat-item .status {
        font-size: 0.75rem;
        color: #64748b;
        text-transform: capitalize;
      }
      .chat-item .status.open {
        color: #d97706;
      }
      .chat-item .status.claimed {
        color: #16a34a;
      }
      .logout-link {
        display: block;
        padding: 14px 18px;
        text-align: center;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        border-top: 1px solid #e2e8f0;
      }
      .main {
        display: flex;
        flex-direction: column;
      }
      .main-header {
        padding: 16px 22px;
        background: #fff;
        border-bottom: 1px solid #e2e8f0;
        font-weight: 700;
      }
      .messages {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 20px;
      }
      .message {
        max-width: 60%;
        padding: 12px 16px;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
      }
      .message.self {
        align-self: flex-end;
        background: #2563eb;
        color: white;
      }
      .message.other {
        align-self: flex-start;
        background: #fff;
      }
      .message .meta {
        font-size: 0.72rem;
        opacity: 0.8;
        margin-bottom: 4px;
      }
      .system-message {
        align-self: center;
        font-size: 0.8rem;
        color: #64748b;
      }
      form.compose {
        display: flex;
        gap: 10px;
        padding: 16px;
        background: #fff;
        border-top: 1px solid #e2e8f0;
      }
      form.compose input {
        flex: 1;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
      }
      form.compose button {
        padding: 12px 20px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        font-weight: 600;
        cursor: pointer;
      }
      .empty-state {
        margin: auto;
        color: #64748b;
      }
      .blocked {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        text-align: center;
        color: #475569;
      }
    </style>
  </head>
  <body>
    <div id="blocked" class="blocked" style="display: none">
      <div>
        <p>You must be logged in as a support agent to view this page.</p>
        <p><a href="/login">Go to login</a></p>
      </div>
    </div>

    <div id="app" class="layout" style="display: none">
      <aside class="sidebar">
        <header>
          <h1>Support Chats</h1>
          <p id="agentName">-</p>
        </header>
        <div id="chatList" class="chat-list"></div>
        <a href="#" class="logout-link" onclick="logout()">Logout</a>
      </aside>

      <section class="main">
        <div id="mainHeader" class="main-header">Select a chat to begin</div>
        <div id="messages" class="messages">
          <p class="empty-state">No chat selected</p>
        </div>
        <form id="composeForm" class="compose" style="display: none">
          <input id="composeInput" autocomplete="off" placeholder="Type your reply..." />
          <button type="submit">Send</button>
        </form>
      </section>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const token = localStorage.getItem("token");
      const role = localStorage.getItem("role");
      const username = localStorage.getItem("username");

      if (!token || role !== "support") {
        document.getElementById("blocked").style.display = "flex";
      } else {
        document.getElementById("app").style.display = "grid";
        document.getElementById("agentName").textContent = username || "Support agent";
        init();
      }

      let socket;
      let activeRoom = null;

      async function init() {
        socket = io(window.location.origin, { auth: { token } });

        socket.on("connect_error", (err) => {
          alert("Connection error: " + err.message);
        });

        socket.on("chat history", (history) => {
          renderMessages(history);
        });

        socket.on("chat message", (msg) => {
          appendMessage(msg);
        });

        socket.on("system message", (sysMsg) => {
          appendSystemMessage(sysMsg.text);
        });

        socket.on("error message", (text) => {
          alert(text);
        });

        await loadChats();
      }

      async function loadChats() {
        try {
          const response = await fetch("/api/support/my-chats", {
            headers: { Authorization: "Bearer " + token },
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || "Failed to load chats");
          renderChatList(data.chats || []);
        } catch (err) {
          alert(err.message);
        }
      }

      function renderChatList(chats) {
        const list = document.getElementById("chatList");
        if (!chats.length) {
          list.innerHTML = "<p style='padding:16px;color:#64748b;'>No chats yet</p>";
          return;
        }

        list.innerHTML = chats
          .map(
            (c) => `
          <div class="chat-item" data-room="${c.room}" onclick="openChat('${c.room}', '${c.patient ? c.patient.name : "Patient"}')">
            <div class="name">${c.patient ? c.patient.name : "Unknown patient"}</div>
            <div class="status ${c.status}">${c.status}</div>
          </div>
        `,
          )
          .join("");
      }

      function openChat(room, patientName) {
        activeRoom = room;
        document.querySelectorAll(".chat-item").forEach((el) => el.classList.remove("active"));
        const el = document.querySelector(`.chat-item[data-room="${room}"]`);
        if (el) el.classList.add("active");

        document.getElementById("mainHeader").textContent = "Chat with " + patientName;
        document.getElementById("composeForm").style.display = "flex";
        document.getElementById("messages").innerHTML = "";

        socket.emit("joinRoom", { room });
      }

      function renderMessages(history) {
        const container = document.getElementById("messages");
        container.innerHTML = "";
        history.forEach((m) => appendMessage(m));
      }

      function appendMessage(msg) {
        const container = document.getElementById("messages");
        const isSelf = msg.senderRole === "support";

        const item = document.createElement("div");
        item.className = "message " + (isSelf ? "self" : "other");

        const meta = document.createElement("div");
        meta.className = "meta";
        meta.textContent = `${msg.senderName || msg.senderIdentifier} • ${formatTime(msg.createdAt)}`;

        const text = document.createElement("div");
        text.textContent = msg.message;

        item.appendChild(meta);
        item.appendChild(text);
        container.appendChild(item);
        container.scrollTop = container.scrollHeight;
      }

      function appendSystemMessage(text) {
        const container = document.getElementById("messages");
        const item = document.createElement("div");
        item.className = "system-message";
        item.textContent = text;
        container.appendChild(item);
        container.scrollTop = container.scrollHeight;
      }

      function formatTime(value) {
        const date = value ? new Date(value) : new Date();
        return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }

      document.getElementById("composeForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("composeInput");
        const message = input.value.trim();
        if (!message || !activeRoom) return;

        socket.emit("chat message", { room: activeRoom, message });
        input.value = "";
      });

      function logout() {
        localStorage.removeItem("token");
        localStorage.removeItem("userId");
        localStorage.removeItem("username");
        localStorage.removeItem("email");
        localStorage.removeItem("role");
        window.location.href = "/login";
      }
    </script>
  </body>
</html>