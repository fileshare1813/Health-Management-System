<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - HMS</title>
    <link rel="stylesheet" href="/css/glass.css" />
  </head>
  <body>
    <div class="center-screen">
      <div class="glass-card container" style="max-width: 450px; width: 100%; padding: 32px;">
        <h1 style="font-size: 1.8rem; text-align: center;">Login</h1>
        <form id="loginForm">
          <label>
            Username
            <input type="text" name="username" placeholder="Enter your username" />
          </label>
          <label>
            Password
            <input type="password" name="password" placeholder="Enter your password" required />
          </label>
          <button type="submit">Login</button>
        </form>
        <div id="feedback" class="message" style="display: none"></div>
        <div class="link">
          Don't have an account? <a href="/register">Register here</a>
        </div>
      </div>
    </div>

    <script>
      const form = document.getElementById("loginForm");
      const feedback = document.getElementById("feedback");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        feedback.style.display = "none";

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
          const response = await fetch("/api/users/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });

          const result = await response.json();
          if (!response.ok) throw new Error(result.error);

          feedback.textContent = "Login successful! Redirecting...";
          feedback.className = "message success";
          feedback.style.display = "block";

          localStorage.setItem("token", result.token);
          localStorage.setItem("userId", result.userId);
          localStorage.setItem("username", result.username);
          localStorage.setItem("email", result.email);
          localStorage.setItem("role", result.role);

          setTimeout(() => {
            if (result.role === "admin") {
              window.location.href = "/admin";
            } else if (result.role === "doctor") {
              window.location.href = "/doctor-dashboard";
            } else if (result.role === "support") {
              window.location.href = "/support";
            } else {
              window.location.href = "/patient";
            }
          }, 1500);
        } catch (err) {
          feedback.textContent = err.message;
          feedback.className = "message error";
          feedback.style.display = "block";
        }
      });
    </script>
  </body>
</html>
