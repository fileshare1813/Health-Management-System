<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Dashboard - HMS</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f6fb;
        color: #1c2331;
      }
      .container {
        max-width: 700px;
        margin: 40px auto;
        background: #fff;
        padding: 24px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .nav {
        margin-bottom: 20px;
        font-size: 0.9rem;
      }
      .nav a {
        color: #2563eb;
        text-decoration: none;
        margin-right: 16px;
        font-weight: 600;
      }
      h1 {
        margin-top: 0;
      }
      .grid {
        display: grid;
        gap: 16px;
      }
      label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-weight: 600;
      }
      input,
      select {
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        font-size: 1rem;
      }
      button {
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        cursor: pointer;
        font-weight: 700;
      }
      .message {
        margin-top: 16px;
        padding: 14px 18px;
        border-radius: 14px;
      }
      .message.success {
        background: #ecfdf5;
        color: #166534;
      }
      .message.error {
        background: #fef2f2;
        color: #b91c1c;
      }
      .blocked {
        text-align: center;
        margin-top: 60px;
        color: #64748b;
      }
      .profile-box {
        background: #f8fafc;
        padding: 16px 20px;
        border-radius: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
      }
      .profile-box p {
        margin: 2px 0;
      }
      .profile-box button {
        margin-top: 10px;
        padding: 8px 14px;
        border: none;
        border-radius: 8px;
        background: #64748b;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
      }
      .pwd-section {
        display: none;
        background: #f8fafc;
        padding: 18px 20px;
        border-radius: 14px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(15, 23, 42, 0.06);
      }
      .pwd-section h3 {
        margin-top: 0;
      }
      .pwd-field-wrapper {
        position: relative;
      }
      .pwd-field-wrapper input {
        width: 100%;
        padding-right: 40px;
        box-sizing: border-box;
      }
      .pwd-toggle-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        user-select: none;
      }
      .pwd-feedback {
        margin-top: 12px;
        display: none;
        padding: 10px 14px;
        border-radius: 10px;
      }
    </style>
  </head>
  <body>
    <div class="container" id="adminContent" style="display: none">
      <div class="nav">
        <a href="/doctors">View Doctors</a>
        <a href="/patient">Book Appointment</a>
        <a href="#" onclick="logout()">Logout</a>
      </div>

      <!-- Profile Info -->
      <div class="profile-box">
        <p><strong>Username:</strong> <span id="profUsername">-</span></p>
        <p><strong>Email:</strong> <span id="profEmail">-</span></p>
        <p><strong>Role:</strong> <span id="profRole">-</span></p>
        <button type="button" onclick="togglePwdSection()">Change Password</button>
      </div>

      <!-- Change Password Form -->
      <div id="pwdSection" class="pwd-section">
        <h3>Change Password</h3>
        <form id="changePwdForm">
          <div class="grid">
            <label>
              Current Password
              <div class="pwd-field-wrapper">
                <input type="password" id="currentPassword" required />
                <span class="pwd-toggle-icon" onclick="togglePwd('currentPassword', this)">👁️</span>
              </div>
            </label>
            <label>
              New Password
              <div class="pwd-field-wrapper">
                <input type="password" id="newPassword" required minlength="8" />
                <span class="pwd-toggle-icon" onclick="togglePwd('newPassword', this)">👁️</span>
              </div>
            </label>
          </div>
          <br />
          <button type="submit">Update Password</button>
        </form>
        <div id="pwdFeedback" class="pwd-feedback"></div>
      </div>

      <h1>Add Doctor</h1>
      <form id="doctorForm">
        <div class="grid">
          <label>
            Doctor Name
            <input type="text" name="name" required />
          </label>
          <label>
            Specialisation
            <input type="text" name="specialisation" required />
          </label>
          <label>
            Degree
            <input type="text" name="degree" required />
          </label>
          <label>
            Fees
            <input type="number" name="fees" min="0" required />
          </label>
          <label>
            Experience (years)
            <input type="number" name="experience" min="0" required />
          </label>
          <label>
            Gender
            <select name="gender">
              <option value="">Select gender</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            Doctor Username (for login)
            <input type="text" name="username" required />
          </label>
          <label>
            Doctor Email (for login)
            <input type="email" name="email" required />
          </label>
          <label>
            Doctor Password (for login)
            <input type="password" name="password" required minlength="6" />
          </label>
        </div>
        <br />
        <button type="submit">Add Doctor</button>
      </form>
      <div id="feedback" class="message" style="display: none"></div>
    </div>

    <div id="blockedMessage" class="blocked" style="display: none">
      <p>You must be logged in as an admin to view this page.</p>
      <p><a href="/login">Go to login</a></p>
    </div>

    <script>
      const token = localStorage.getItem("token");
      const role = localStorage.getItem("role");

      if (!token || role !== "admin") {
        document.getElementById("blockedMessage").style.display = "block";
      } else {
        document.getElementById("adminContent").style.display = "block";
      }

      const form = document.getElementById("doctorForm");
      const feedback = document.getElementById("feedback");

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        feedback.style.display = "none";

        const formData = new FormData(form);
        const data = Object.fromEntries(formData);

        try {
          const response = await fetch("/api/doctors/add-doctor", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + token,
            },
            body: JSON.stringify(data),
          });

          const result = await response.json();
          if (!response.ok) throw new Error(result.error || "Failed to add doctor");

          feedback.textContent = `Doctor "${result.doctor.name}" added successfully! Login: ${data.username}`;
          feedback.className = "message success";
          feedback.style.display = "block";
          form.reset();
        } catch (err) {
          feedback.textContent = err.message;
          feedback.className = "message error";
          feedback.style.display = "block";
        }
      });

      // ----- Logout -----
      function logout() {
        localStorage.removeItem("token");
        localStorage.removeItem("userId");
        localStorage.removeItem("username");
        localStorage.removeItem("email");
        localStorage.removeItem("role");
        window.location.href = "/login";
      }

      // ----- Profile info -----
      document.getElementById("profUsername").textContent =
        localStorage.getItem("username") || "-";
      document.getElementById("profEmail").textContent =
        localStorage.getItem("email") || "-";
      document.getElementById("profRole").textContent =
        localStorage.getItem("role") || "-";

      function togglePwdSection() {
        const section = document.getElementById("pwdSection");
        section.style.display =
          section.style.display === "block" ? "none" : "block";
      }

      // ----- Password show/hide -----
      function togglePwd(inputId, iconEl) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
          input.type = "text";
          iconEl.textContent = "🙈";
        } else {
          input.type = "password";
          iconEl.textContent = "👁️";
        }
      }

      // ----- Change password submit -----
      const changePwdForm = document.getElementById("changePwdForm");
      const pwdFeedback = document.getElementById("pwdFeedback");

      changePwdForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        pwdFeedback.style.display = "none";

        const currentPassword = document.getElementById("currentPassword").value;
        const newPassword = document.getElementById("newPassword").value;

        try {
          const response = await fetch("/api/users/change-password", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + token,
            },
            body: JSON.stringify({ currentPassword, newPassword }),
          });

          const data = await response.json();
          if (!response.ok)
            throw new Error(data.error || "Failed to change password");

          pwdFeedback.textContent = "Password updated successfully!";
          pwdFeedback.style.background = "#ecfdf5";
          pwdFeedback.style.color = "#166534";
          pwdFeedback.style.display = "block";
          changePwdForm.reset();
        } catch (err) {
          pwdFeedback.textContent = err.message;
          pwdFeedback.style.background = "#fef2f2";
          pwdFeedback.style.color = "#b91c1c";
          pwdFeedback.style.display = "block";
        }
      });
    </script>
  </body>
</html>
