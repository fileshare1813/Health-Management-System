<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Patient Appointment Booking</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f6fb;
        color: #1c2331;
      }
      .container {
        max-width: 700px;
        margin: 40px auto;
        background: #fff;
        padding: 24px;
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .nav {
        margin-bottom: 20px;
        font-size: 0.9rem;
      }
      .nav a {
        color: #2563eb;
        text-decoration: none;
        margin-right: 16px;
        font-weight: 600;
      }
      h1 {
        margin-top: 0;
        font-size: 2rem;
      }
      .grid {
        display: grid;
        gap: 16px;
      }
      label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-weight: 600;
      }
      input,
      select,
      textarea {
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        font-size: 1rem;
      }
      button {
        padding: 14px 18px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        cursor: pointer;
        font-weight: 700;
      }
      .message {
        margin-top: 16px;
        padding: 14px 18px;
        border-radius: 14px;
      }
      .message.success {
        background: #ecfdf5;
        color: #166534;
      }
      .message.error {
        background: #fef2f2;
        color: #b91c1c;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="nav">
        <a href="/doctors">Find a Doctor</a>
        <a href="/my-appointments">My Appointments</a>
        <a href="/support">Support Chat</a>
      </div>
      <h1>Book an Appointment</h1>
      <form id="appointmentForm" enctype="multipart/form-data">
        <div class="grid">
          <label>
            Patient Name
            <input type="text" name="name" id="name" required />
          </label>
          <label>
            Email
            <input type="email" name="email" id="email" required />
          </label>
          <label>
            Age
            <input type="number" name="age" id="age" min="0" required />
          </label>
          <label>
            Gender
            <select name="gender" id="gender" required>
              <option value="">Select gender</option>
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>
            Address
            <textarea name="address" id="address" rows="3" required></textarea>
          </label>
          <label>
            Ailment
            <input type="text" name="ailment" id="ailment" required />
          </label>
          <label>
            Doctor ID
            <input
              type="text"
              name="doctorChoice"
              id="doctorChoice"
              required
              placeholder="Enter doctor ObjectId or pick from Find a Doctor"
            />
          </label>
          <label>
            Appointment Slot
            <input
              type="text"
              name="bookedSlot"
              id="bookedSlot"
              required
              placeholder="e.g. 2026-07-20 10:00 AM"
            />
          </label>
          <label>
            Prescription File
            <input
              type="file"
              name="prescription"
              id="prescription"
              accept=".jpg,.jpeg,.png,.pdf"
              required
            />
          </label>
        </div>
        <button type="submit">Book Appointment</button>
      </form>
      <div id="feedback" class="message" style="display: none"></div>
    </div>

    <script>
      const form = document.getElementById("appointmentForm");
      const feedback = document.getElementById("feedback");

      // Auto-fill doctor ID if navigated here from the "Find a Doctor" page
      const params = new URLSearchParams(window.location.search);
      const doctorIdFromQuery = params.get("doctorId");
      if (doctorIdFromQuery) {
        document.getElementById("doctorChoice").value = doctorIdFromQuery;
      }

      // Pre-fill email if already logged in
      const savedEmail = localStorage.getItem("email");
      if (savedEmail) {
        document.getElementById("email").value = savedEmail;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        feedback.style.display = "none";
        feedback.textContent = "";
        feedback.className = "message";

        const token = localStorage.getItem("token");
        if (!token) {
          feedback.textContent = "Please login first to book an appointment.";
          feedback.classList.add("error");
          feedback.style.display = "block";
          return;
        }

        const formData = new FormData(form);
        try {
          const response = await fetch("/api/patients/book-appointment", {
            method: "POST",
            headers: {
              Authorization: "Bearer " + token,
            },
            body: formData,
          });

          const data = await response.json();
          if (!response.ok) {
            throw new Error(data.error || "Unable to book appointment");
          }

          feedback.textContent =
            data.message || "Appointment booked successfully";
          feedback.classList.add("success");
          feedback.style.display = "block";
          form.reset();
        } catch (error) {
          feedback.textContent = error.message;
          feedback.classList.add("error");
          feedback.style.display = "block";
        }
      });
    </script>
  </body>
</html>