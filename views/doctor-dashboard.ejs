<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Doctor Dashboard - HMS</title>
    <style>
      body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f6fb;
        color: #1c2331;
      }
      .container {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
      }
      .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .top-bar a.logout-link {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.9rem;
      }
      h1 {
        margin-top: 0;
      }
      .doctor-info {
        background: #fff;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .doctor-info h2 {
        margin: 0 0 6px;
      }
      .doctor-info p {
        margin: 4px 0;
        color: #475569;
      }
      .profile-box {
        background: #fff;
        padding: 16px 20px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .profile-box p {
        margin: 2px 0;
      }
      .profile-box button {
        margin-top: 10px;
        padding: 8px 14px;
        border: none;
        border-radius: 8px;
        background: #64748b;
        color: #fff;
        cursor: pointer;
        font-weight: 600;
      }
      .pwd-section {
        display: none;
        background: #fff;
        padding: 18px 20px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .pwd-section h3 {
        margin-top: 0;
      }
      .pwd-section .grid {
        display: grid;
        gap: 16px;
      }
      .pwd-section label {
        display: flex;
        flex-direction: column;
        gap: 8px;
        font-weight: 600;
      }
      .pwd-field-wrapper {
        position: relative;
      }
      .pwd-field-wrapper input {
        width: 100%;
        padding: 12px 40px 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
        font-size: 1rem;
        box-sizing: border-box;
      }
      .pwd-toggle-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        cursor: pointer;
        user-select: none;
      }
      .pwd-section button[type="submit"] {
        padding: 12px 18px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        cursor: pointer;
        font-weight: 700;
      }
      .pwd-feedback {
        margin-top: 12px;
        display: none;
        padding: 10px 14px;
        border-radius: 10px;
      }
      .section-title {
        font-size: 1.2rem;
        margin: 28px 0 12px;
      }
      .appointment-card {
        background: #fff;
        border-radius: 16px;
        padding: 18px;
        margin-bottom: 14px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
      }
      .appointment-card h3 {
        margin: 0 0 6px;
      }
      .appointment-card p {
        margin: 3px 0;
        font-size: 0.9rem;
        color: #475569;
      }
      .appointment-card a {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
      }
      .chat-card {
        background: #fff;
        border-radius: 16px;
        padding: 16px 18px;
        margin-bottom: 12px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
      }
      .chat-card .name {
        font-weight: 700;
      }
      .chat-card .status {
        font-size: 0.78rem;
        color: #64748b;
        text-transform: capitalize;
      }
      .chat-card button {
        padding: 10px 16px;
        border: none;
        border-radius: 10px;
        background: #2563eb;
        color: white;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
      }
      .empty,
      .blocked {
        text-align: center;
        color: #64748b;
        margin-top: 60px;
      }

      /* ---- Chat panel (modal-style overlay) ---- */
      #chatOverlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 50;
      }
      #chatPanel {
        background: #fff;
        width: 92%;
        max-width: 480px;
        height: 80vh;
        border-radius: 18px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      #chatPanel .chat-header {
        padding: 14px 18px;
        background: #2563eb;
        color: #fff;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
      }
      #chatPanel .chat-header span.close-btn {
        cursor: pointer;
        font-weight: 400;
        font-size: 1.3rem;
        line-height: 1;
      }
      #chatMessages {
        flex: 1;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 16px;
        background: #eef2ff;
      }
      .message {
        max-width: 82%;
        padding: 12px 14px;
        border-radius: 16px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.08);
      }
      .message.self {
        align-self: flex-end;
        background: #2563eb;
        color: white;
      }
      .message.other {
        align-self: flex-start;
        background: #fff;
      }
      .message .meta {
        font-size: 0.72rem;
        opacity: 0.8;
        margin-bottom: 4px;
      }
      .system-message {
        align-self: center;
        font-size: 0.78rem;
        color: #64748b;
      }
      #chatForm {
        display: flex;
        gap: 10px;
        padding: 14px;
        background: #fff;
        border-top: 1px solid #e2e8f0;
      }
      #chatForm input {
        flex: 1;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 12px;
      }
      #chatForm button {
        padding: 12px 18px;
        border: none;
        border-radius: 12px;
        background: #2563eb;
        color: white;
        font-weight: 600;
        cursor: pointer;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="top-bar">
        <h1>My Appointments</h1>
        <a href="#" class="logout-link" onclick="logout()">Logout</a>
      </div>

      <!-- Profile Info -->
      <div class="profile-box">
        <p><strong>Username:</strong> <span id="profUsername">-</span></p>
        <p><strong>Email:</strong> <span id="profEmail">-</span></p>
        <p><strong>Role:</strong> <span id="profRole">-</span></p>
        <button type="button" onclick="togglePwdSection()">Change Password</button>
      </div>

      <!-- Change Password Form -->
      <div id="pwdSection" class="pwd-section">
        <h3>Change Password</h3>
        <form id="changePwdForm">
          <div class="grid">
            <label>
              Current Password
              <div class="pwd-field-wrapper">
                <input type="password" id="currentPassword" required />
                <span class="pwd-toggle-icon" onclick="togglePwd('currentPassword', this)">👁️</span>
              </div>
            </label>
            <label>
              New Password
              <div class="pwd-field-wrapper">
                <input type="password" id="newPassword" required minlength="8" />
                <span class="pwd-toggle-icon" onclick="togglePwd('newPassword', this)">👁️</span>
              </div>
            </label>
          </div>
          <br />
          <button type="submit">Update Password</button>
        </form>
        <div id="pwdFeedback" class="pwd-feedback"></div>
      </div>

      <div id="doctorInfo"></div>
      <div id="list"></div>

      <!-- Patient Chats -->
      <h2 class="section-title">Patient Messages</h2>
      <div id="chatList"></div>
    </div>

    <!-- Chat overlay panel -->
    <div id="chatOverlay">
      <div id="chatPanel">
        <div class="chat-header">
          <span id="chatPatientName">Chat</span>
          <span class="close-btn" onclick="closeChat()">&times;</span>
        </div>
        <div id="chatMessages"></div>
        <form id="chatForm">
          <input id="chatInput" autocomplete="off" placeholder="Type your reply..." />
          <button type="submit">Send</button>
        </form>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script>
      const list = document.getElementById("list");
      const doctorInfo = document.getElementById("doctorInfo");
      const chatList = document.getElementById("chatList");
      const token = localStorage.getItem("token");
      const role = localStorage.getItem("role");

      async function loadAppointments() {
        if (!token || role !== "doctor") {
          list.innerHTML =
            "<p class='blocked'>You must be logged in as a doctor to view this page. <a href='/login'>Login</a></p>";
          return;
        }

        try {
          const response = await fetch("/api/doctors/my-appointments", {
            headers: { Authorization: "Bearer " + token },
          });
          const data = await response.json();

          if (!response.ok)
            throw new Error(data.error || "Failed to load appointments");

          doctorInfo.innerHTML = `
            <div class="doctor-info">
              <h2>Dr. ${data.doctor.name}</h2>
              <p>${data.doctor.specialisation} • ${data.doctor.degree}</p>
              <p>Rating: ★ ${data.doctor.rating ? data.doctor.rating.toFixed(1) : "No ratings yet"}</p>
            </div>
          `;

          renderAppointments(data.appointments || []);
        } catch (err) {
          list.innerHTML = `<p class="empty">${err.message}</p>`;
        }
      }

      function renderAppointments(appointments) {
        if (!appointments.length) {
          list.innerHTML = "<p class='empty'>You have no appointments yet.</p>";
          return;
        }

        list.innerHTML = appointments
          .map(
            (a) => `
          <div class="appointment-card">
            <h3>${a.name}</h3>
            <p>Email: ${a.email} | Age: ${a.age} | Gender: ${a.gender}</p>
            <p>Ailment: ${a.ailment}</p>
            <p>Slot: ${a.bookedSlot}</p>
            ${
              a.prescriptions && a.prescriptions.length
                ? `<p><a href="${a.prescriptions[a.prescriptions.length - 1]}" target="_blank">View Prescription File</a></p>`
                : ""
            }
          </div>
        `,
          )
          .join("");
      }

      // ----- Patient chat list -----
      async function loadChats() {
        if (!token || role !== "doctor") return;

        try {
          const response = await fetch("/api/doctors/my-chats", {
            headers: { Authorization: "Bearer " + token },
          });
          const data = await response.json();

          if (!response.ok)
            throw new Error(data.error || "Failed to load chats");

          renderChats(data.chats || []);
        } catch (err) {
          chatList.innerHTML = `<p class="empty">${err.message}</p>`;
        }
      }

      function renderChats(chats) {
        if (!chats.length) {
          chatList.innerHTML =
            "<p class='empty'>No patients to message yet. Chats appear here once a patient books with you.</p>";
          return;
        }

        chatList.innerHTML = chats
          .map(
            (c) => `
          <div class="chat-card">
            <div>
              <div class="name">${c.patient ? c.patient.name : "Patient"}</div>
              <div class="status">${c.status}</div>
            </div>
            <button onclick='openChat(${JSON.stringify(c.room)}, ${JSON.stringify(c.patient ? c.patient.name : "Patient")})'>Message</button>
          </div>
        `,
          )
          .join("");
      }

      // ----- Chat socket logic -----
      let socket;
      let activeRoom = null;

      function ensureSocket() {
        if (socket) return socket;
        socket = io(window.location.origin, { auth: { token } });

        socket.on("connect_error", (err) => alert("Connection error: " + err.message));
        socket.on("chat history", (history) => {
          const container = document.getElementById("chatMessages");
          container.innerHTML = "";
          history.forEach((m) => appendMessage(m));
        });
        socket.on("chat message", (m) => appendMessage(m));
        socket.on("system message", (sysMsg) => appendSystemMessage(sysMsg.text));
        socket.on("error message", (text) => appendSystemMessage(text));

        return socket;
      }

      function openChat(room, patientName) {
        activeRoom = room;
        document.getElementById("chatPatientName").textContent = "Chat with " + patientName;
        document.getElementById("chatMessages").innerHTML = "";
        document.getElementById("chatOverlay").style.display = "flex";

        ensureSocket().emit("joinRoom", { room });
      }

      function closeChat() {
        document.getElementById("chatOverlay").style.display = "none";
        activeRoom = null;
      }

      document.getElementById("chatForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("chatInput");
        const message = input.value.trim();
        if (!message || !activeRoom || !socket) return;

        socket.emit("chat message", { room: activeRoom, message });
        input.value = "";
      });

      function appendMessage(msg) {
        const container = document.getElementById("chatMessages");
        const isSelf = msg.senderRole === "doctor";

        const item = document.createElement("div");
        item.className = "message " + (isSelf ? "self" : "other");

        const meta = document.createElement("div");
        meta.className = "meta";
        meta.textContent = `${msg.senderName || msg.senderIdentifier} • ${formatTime(msg.createdAt)}`;

        const text = document.createElement("div");
        text.textContent = msg.message;

        item.appendChild(meta);
        item.appendChild(text);
        container.appendChild(item);
        container.scrollTop = container.scrollHeight;
      }

      function appendSystemMessage(text) {
        const container = document.getElementById("chatMessages");
        const item = document.createElement("div");
        item.className = "system-message";
        item.textContent = text;
        container.appendChild(item);
        container.scrollTop = container.scrollHeight;
      }

      function formatTime(value) {
        const date = value ? new Date(value) : new Date();
        return date.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }

      loadAppointments();
      loadChats();

      // ----- Logout -----
      function logout() {
        localStorage.removeItem("token");
        localStorage.removeItem("userId");
        localStorage.removeItem("username");
        localStorage.removeItem("email");
        localStorage.removeItem("role");
        window.location.href = "/login";
      }

      // ----- Profile info -----
      document.getElementById("profUsername").textContent =
        localStorage.getItem("username") || "-";
      document.getElementById("profEmail").textContent =
        localStorage.getItem("email") || "-";
      document.getElementById("profRole").textContent =
        localStorage.getItem("role") || "-";

      function togglePwdSection() {
        const section = document.getElementById("pwdSection");
        section.style.display =
          section.style.display === "block" ? "none" : "block";
      }

      // ----- Password show/hide -----
      function togglePwd(inputId, iconEl) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
          input.type = "text";
          iconEl.textContent = "🙈";
        } else {
          input.type = "password";
          iconEl.textContent = "👁️";
        }
      }

      // ----- Change password submit -----
      const changePwdForm = document.getElementById("changePwdForm");
      const pwdFeedback = document.getElementById("pwdFeedback");

      changePwdForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        pwdFeedback.style.display = "none";

        const currentPassword = document.getElementById("currentPassword").value;
        const newPassword = document.getElementById("newPassword").value;

        try {
          const response = await fetch("/api/users/change-password", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              Authorization: "Bearer " + token,
            },
            body: JSON.stringify({ currentPassword, newPassword }),
          });

          const data = await response.json();
          if (!response.ok)
            throw new Error(data.error || "Failed to change password");

          pwdFeedback.textContent = "Password updated successfully!";
          pwdFeedback.style.background = "#ecfdf5";
          pwdFeedback.style.color = "#166534";
          pwdFeedback.style.display = "block";
          changePwdForm.reset();
        } catch (err) {
          pwdFeedback.textContent = err.message;
          pwdFeedback.style.background = "#fef2f2";
          pwdFeedback.style.color = "#b91c1c";
          pwdFeedback.style.display = "block";
        }
      });
    </script>
  </body>
</html>